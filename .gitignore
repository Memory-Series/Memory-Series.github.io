# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Worktrees
.worktrees

# Local agent memory / tooling data
.workbuddy/

# Internal working archives — MUST NOT be published.
# harness/ carries the server host, deploy topology and other operational detail;
# .screenshots/ and compositions/ are local build/production assets.
harness/
.screenshots/
compositions/

# Deploy tooling that hard-codes the production host — keep local only.
scripts/deploy-jd.ps1

# Chat server (C1 thin proxy) — see harness/docs/spec-chat-server.md §7.3
# personas/ is synthesized at deploy time from the sibling Trace-Inhabit repo:
# keeping a copy here would re-publish third-party prompt text in a public repo
# AND silently go stale whenever the source is updated.
server/personas/
# Runtime counters (daily circuit-breaker). Never in the repo.
server/state/
# Secrets. The MiniMax key and the IP hash salt live only in the server's .env.
.env
.env.*

# Render artifacts
compositions/*.mp4
compositions/snapshots/

# Deployment archives (hand-built from dist/ for the JD Cloud upload)
*.tar.gz

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
